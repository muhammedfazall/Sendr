APP_ENV=development

DB_URL=postgres://sendr:secret@localhost:5433/sendr?sslmode=disable
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY_PATH=./private.pem
JWT_PUBLIC_KEY_PATH=./public.pem

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=replace-with-a-long-random-secret

# Email provider: sendgrid (default), mailgun, smtp, mock
EMAIL_PROVIDER=sendgrid

SENDGRID_KEY=
MAILGUN_DOMAIN=
MAILGUN_KEY=
MAILGUN_BASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=noreply@example.com
FROM_NAME=Sendr

PORT=8080

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Unsubscribe — used in List-Unsubscribe header and /unsubscribe page
UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=